# Discord Bot Authentication Token (from Discord Developer Portal)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/discord_events

# Optional Guild IDs (comma-separated, overrides config.json if set)
# MASTER_GUILD_IDS=123456789012345678,987654321098765432
# PREMIUM_GUILD_IDS=123456789012345678
